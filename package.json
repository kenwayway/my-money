{
  "name": "my-money",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev -w packages/server",
    "dev:web": "npm run dev -w packages/web",
    "build": "npm run build -w packages/web && npm run build -w packages/server",
    "start": "npm run start -w packages/server"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
